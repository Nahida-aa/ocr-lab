# subtitle-ocr：纯感知 OCR 工具（对标 cpp 的 ocr_pipeline.cpp）。
# 用法（在 packages/subtitle-ocr/ 下）：
#   just                       # 默认 = 显示任务列表
#   just build                 # release 编译
#   just test                  # 跑单测
#   just run <image>           # 单图识别（输出逐帧 JSON 数组到 stdout）
#   just run-dir <dir>         # 批量识别（文件名须为 ms / ms_ms 时间格式）
#   just run-out <image> <out> # 单图识别并写出 OcrFramesResult 到指定文件
#   just merge <frames> [out]  # 多帧合并：逐帧 JSON → 带时间轴字幕段
#   just adjust-box <frames> [out]  # 字幕框调整：逐帧 JSON(含boxes) → 调整后框+meta
#   just filter-box <adj> [out]     # 离群框过滤：adjust 输出 → 干净逐帧结果
#   just adjust-segment [seg] [frames] [video] [out]  # 字幕段置信度调整：合并段+干净帧+视频 → 带惩罚/调整后置信度
#   just filter-segment <adj> [out] # 字幕段过滤：adjust 输出 → 按阈值丢弃低置信段
#   just ocr-post [frames] [video] [out]  # 统合后处理管线：一条命令跑完全部 5 步
#   just doc                   # 构建文档（带私有项，便于看内部模块）
#
# 输出：stdout 为与 cpp 同形状的 JSON 数组（text/confidence/boxes/timestamp）；
#       --out 额外落地 OcrFramesResult（{frames, meta}），文件名由调用方指定
#       （如 asr_ocr_frames.json / sf_ocr_frames.json），对齐 LocalDub。

# ---- 默认任务（`just` 无参即显示列表） ----
default:
    @just --list

# ---- 编译（release，含 LTO） ----
build:
    cargo build -p subtitle-ocr --release

# ---- 单测 ----
test:
    cargo test -p subtitle-ocr

# ---- 单图识别（位置传图，输出 JSON 数组到 stdout） ----
# 用法：just run <image>
run image="tmp/both_fullscreen_frame1.png":
    cargo run -p subtitle-ocr --release -- {{image}}

# ---- 批量识别（--dir，文件名须为 ms / ms_ms 时间格式） ----
# 用法：just run-dir <dir>
run-dir dir="tmp/大/20/sf_ocr_pre/frames" out="tmp/大/20/sf_ocr/frames.json":
    cargo run -p subtitle-ocr --release -- --dir {{dir}} --out {{out}} --subtitle-only

# ---- 单图识别并写出 OcrFramesResult 到调用方指定文件 ----
# 用法：just run-out <image> <out>
run_out image="tmp/both_fullscreen_frame1.png" out="tmp/ocr_frames.json":
    cargo run -p subtitle-ocr --release -- {{image}} --out {{out}}

# ---- 构建文档（含私有项） ----
doc:
    cargo doc -p subtitle-ocr --no-deps --document-private-items


# ---- 字幕框调整：给逐帧 JSON 的框算偏离/噪声惩罚、标记离群 ----
# 用法：just adjust-box <frames.json> [out]
# 输入须含 boxes（调整依赖框几何），由主 CLI（subtitle-ocr --out）产出；
# 输出 OcrBoxAdjustResult { frames, meta } 到 stdout（--out 额外落盘）。
adjust-box in="tmp/3/sf_ocr/frames.json" out="tmp/3/sf_ocr_fix/frames_box_adjust.json":
    cargo run -p subtitle-ocr --bin ocr-frames-adjust-box --release -- {{in}} --out {{out}}

# ---- 离群框过滤：剔除 is_outlier 框、重聚合得到干净帧 ----
# 用法：just filter-box <adjusted.json> [out]
# 输入为 adjust-box 步骤的输出（含 is_outlier 标记）；
# 输出 OcrFramesBoxFilteredResult { frames, meta } 到 stdout（--out 额外落盘）。
filter-box in="tmp/3/sf_ocr_fix/frames_box_adjust.json" out="tmp/3/sf_ocr_fix/frames_box_filter.json":
    cargo run -p subtitle-ocr --bin ocr-frames-filter-box --release -- {{in}} --out {{out}}

# ---- 多帧合并：把逐帧 JSON（asr_ocr_frames.json 等）合并成带时间轴的字幕段 ----
# 用法：just merge <frames.json> [out]
# 输入为主 CLI（subtitle-ocr --out）产出的 FrameResult[] 或 {frames,meta}；
# 输出 MergeFramesResult { text, segments } 到 stdout（--out 额外落盘）。
merge in="tmp/3/sf_ocr_fix/frames_box_filter.json" out="tmp/3/sf_ocr_fix/frames_merged.json":
    cargo run -p subtitle-ocr --bin merge-frames --release -- {{in}} --out {{out}}

# ---- 字幕段置信度调整：给合并段补 Y 偏移/孤立惩罚与调整后置信度 ----
# 用法：just adjust-segment [segments] [frames] [video] [out]
# 输入三段：segments（merge-frames 输出）、frames（filter-box 干净帧）、
# video（视频路径，读高度）；视频高度从视频读取，不手填。
# 输出 OcrSegmentWithAdjust[] 到 stdout（--out 额外落盘），供下游 ocr-segment-filter 消费。
adjust-segment segments="tmp/3/sf_ocr_fix/frames_merged.json" frames="tmp/3/sf_ocr_fix/frames_box_filter.json" video="tmp/3/video_source.mp4" out="tmp/3/sf_ocr_fix/segment_adjust.json":
    cargo run -p subtitle-ocr --bin ocr-segment-adjust --release -- --segments {{segments}} --frames {{frames}} --video {{video}} --out {{out}}

# ---- 字幕段置信度过滤：按阈值丢弃低置信段 ----
# 用法：just filter-segment <adjusted.json> [out] [threshold]
# 输入为 adjust-segment 步骤的输出（含 adjusted_text_confidence）；
# 输出 OcrSegmentFilterResult { meta, result } 到 stdout（--out 额外落盘）；
# 加 --bare 则输出纯 OcrSegmentWithAdjust[] 数组。
filter-segment in="tmp/3/sf_ocr_fix/segment_adjust.json" out="tmp/3/sf_ocr_fix/segment_filter.json" threshold="0.6":
    cargo run -p subtitle-ocr --bin ocr-segment-filter --release -- {{in}} --text-confidence-threshold {{threshold}} --out {{out}}

# ---- 统合后处理管线：一条命令串起 adjust-box → filter-box → merge → adjust-segment → filter-segment ----
# 用法：just ocr-post [frames] [video] [out] [threshold] [stop_at]
# 输入 frames（逐帧 OCR JSON，subtitle-ocr --out 产出）与 video（视频路径，读高度）；
# 各中间产物（frames_box_adjust.json / frames_box_filter.json / frames_merged.json /
# segment_adjust.json / segment_filter.json）都写到 out 目录。--stop-at 可只跑到某一步。
ocr-post frames="tmp/大/48/sf_ocr/frames.json" video="tmp/大/48/video_source.mp4" out="tmp/大/48/sf_ocr_fix" threshold="0.45" stop_at="filter-segment":
    cargo run -p subtitle-ocr --bin ocr-post --release -- --frames {{frames}} --video {{video}} --out {{out}} --threshold {{threshold}} --stop-at {{stop_at}}
