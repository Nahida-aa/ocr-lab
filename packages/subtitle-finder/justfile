# subtitle-finder：吃视频 → 输出字幕关键帧 + 时间轴（复刻 VideoSubFinder 筛选管线）。
# 用法（在 packages/subtitle-finder/ 下）：
#   just                       # 默认 = 显示任务列表
#   just build                 # release 编译
#   just run <video> [out]     # 跑视频，输出关键帧（out 可选，默认包内 out/）
#   just profile <video> [out] # 带分阶段耗时剖析跑
#   just test                  # 跑单测
#   just ocr <video> [out]     # 跑 + 用 subtitle-ocr 对关键帧原始帧 OCR
#   just out-clean             # 清空 out/（关键帧 + mask + json）
# 参数用位置传：just run /tmp/a.mp4 /tmp/out_dir （video, out 按序；out 省略则默认 out/）
#
# 输出：packages/subtitle-finder/out/{start}_{end}_{i}.png + _mask.png +
#       timeline.txt + keyframes.json

# ---- 默认任务（`just` 无参即显示列表） ----
default:
    @just --list

# ---- 编译（release，含 LTO） ----
build:
    cargo build -p subtitle-finder --release

# ---- 跑一段视频（输出关键帧 + 时间轴到 out/ 或 --out 指定目录） ----
# 用法：just run                    # 默认视频 + 默认 out/
#       just run <video>            # 指定视频
#       just run <video> <out_dir>  # 指定视频 + 输出目录（位置参数）
run video="/tmp/clip5s.mp4" out="":
    cargo run -p subtitle-finder --release -- {{video}} {{ if out != "" { "--out " + out } else { "" } }}

# ---- 带分阶段耗时剖析跑 ----
profile video="/tmp/clip5s.mp4" out="":
    cargo run -p subtitle-finder --release -- --profile {{video}} {{ if out != "" { "--out " + out } else { "" } }}

# ---- 跑 + 用 subtitle-ocr 对 out/ 所有关键帧 OCR（批量，验证字幕识别） ----
# 用法：just ocr <video> [out]（位置参数）
# 注：subtitle-ocr --dir 需绝对路径；OCR 的图（含原始帧 + _mask）里看原始帧结果。
ocr video="/tmp/clip5s.mp4" out="":
    cargo run -p subtitle-finder --release -- {{video}} {{ if out != "" { "--out " + out } else { "" } }}
    @if [ -n "{{out}}" ]; then cargo run -p subtitle-ocr --release -- --dir {{out}} --subtitle-only; \
       else cargo run -p subtitle-ocr --release -- --dir $(pwd)/out --subtitle-only; fi

# ---- 完整例子：subtitle-finder 提关键帧 → subtitle-ocr 逐张 OCR → 带时间轴字幕 ----
# 用法：just example <video> [out]；脚本见 docs/ocr_example.sh
example video="/tmp/clip5s.mp4" out="":
    @if [ -n "{{out}}" ]; then ./docs/ocr_example.sh {{video}} {{out}}; \
       else ./docs/ocr_example.sh {{video}}; fi

# ---- 单测 ----
test:
    cargo test -p subtitle-finder

# ---- 清空 out/（关键帧产物） ----
out-clean:
    @rm -f out/*.png out/timeline.txt out/keyframes.json
